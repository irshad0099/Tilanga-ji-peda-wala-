# Copy this file to .env.local for local development, and add the same
# keys under Vercel → Project → Settings → Environment Variables for
# production. See README.md "Set up MongoDB Atlas" for the full steps.

# MongoDB Atlas connection string (Atlas → Connect → Drivers → Node.js).
# Include the database user's password and keep this secret.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional — database name (defaults to "tilanga_ji" if omitted).
MONGODB_DB=tilanga_ji

# A password you make up yourself, to log into /admin and see orders.
ADMIN_KEY=choose-a-long-random-password

# Razorpay — online payments (UPI, cards, netbanking, wallets).
# Razorpay Dashboard → Account & Settings → API Keys. Start with the Test Mode
# keys (rzp_test_…); swap in the Live Mode keys (rzp_live_…) once Razorpay
# has activated the account. Leave these empty to offer cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard → Account & Settings → Webhooks → Add new webhook.
#   URL:    https://<your-domain>/api/razorpay/webhook
#   Secret: make one up and paste the same value here
#   Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=
