# Copy to .env.local for local development; add the same keys to this admin
# app's own Vercel project for production.

# The shop's MongoDB Atlas database — the SAME values as the shop site.
MONGODB_URI=
MONGODB_DB=tilanga_ji

# The one admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Any long random string. Signs login sessions; changing it signs everyone out.
SESSION_SECRET=

# The shop site, and the shared secret its /api/revalidate route checks, so
# price/stock/settings edits show on the shop immediately.
SHOP_URL=https://tilangaji.com
REVALIDATE_SECRET=
